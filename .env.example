# Copy to .env and fill in values. Do not commit .env.

# --- Azure OpenAI (optional if using OpenAI.com or local-only) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=gpt-4.1

# --- OpenAI.com (optional) ---
OPENAI_API_KEY=
# OPEN_AI_KEY=   # legacy alias supported by app

# --- Chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Embedding id: azure_ada | openai_small | openai_ada | bge_m3
EMBED_MODEL=azure_ada

# --- Qdrant ---
VECTOR_DB=qdrant
# QDRANT_URL=http://localhost:6333
VECTOR_DB_URL=http://localhost:6333
QDRANT_PORT=6333
# Optional prefix for Qdrant collection names (e.g. rag_)
QDRANT_COLLECTION_PREFIX=

# Legacy AutoGen / CLI retrieve_context default (optional)
# DEFAULT_RAG_COLLECTION=my_collection

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL_PRIMARY=qwen2.5:7b-instruct

# --- Paths ---
DATA_ROOT=./data
STATE_ROOT=./state

# Minimum characters after PDF extract to treat as non-scanned (optional)
# MIN_EXTRACTED_TEXT_CHARS=40
