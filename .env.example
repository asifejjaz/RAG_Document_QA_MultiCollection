# Copy to .env and fill in values. Do not commit .env.

# --- OpenAI.com (recommended default) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (optional alternative) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=gpt-4.1

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
# For Qdrant Cloud, use the cloud cluster URL and API key:
# QDRANT_URL=https://xxxxxxxx.aws.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_PREFIX=rag_

# --- Chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=150


DEFAULT_LLM=openai       # Options: azure | openai | ollama_qwen2.5 | ollama_llama3.1
EMBED_MODEL=openai_small # Supported IDs: azure_ada | openai_small | openai_ada | bge_m3

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL_PRIMARY=qwen2.5:7b-instruct
LOCAL_LLM_MODEL_SECONDARY=llama3.1:8b-instruct

# --- Paths ---
DATA_ROOT=./data
STATE_ROOT=./state

# Minimum characters after PDF extract to treat as non-scanned (optional)
# MIN_EXTRACTED_TEXT_CHARS=40
